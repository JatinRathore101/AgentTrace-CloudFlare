{
  "name": "agenttrace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome format --write",
    "cf-typegen": "wrangler types"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@vinext/cloudflare": "^1.2.1",
    "agents": "^0.30.1",
    "next": "15.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.2.0",
    "react-server-dom-webpack": "^19.3.1",
    "redux-persist": "^6.0.0",
    "vinext": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.152.0"
  }
}
