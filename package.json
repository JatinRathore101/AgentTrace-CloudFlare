{
  "name": "agenttrace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development npx next dev --turbopack",
    "build": "NODE_ENV=production npx next build --turbopack",
    "start": "NODE_ENV=production npx next start",
    "lint": "biome check",
    "format": "biome format --write",
    "setup": "npx tsx src/setup.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@vinext/cloudflare": "^1.2.1",
    "agents": "^0.30.1",
    "better-sqlite3": "^12.6.2",
    "json5": "^2.2.3",
    "next": "15.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.6.0",
    "react-redux": "^9.2.0",
    "react-server-dom-webpack": "^19.3.1",
    "redux-persist": "^6.0.0",
    "vinext": "^1.3.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/winston": "^2.4.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "tailwindcss": "^4",
    "ts-node": "^10",
    "tsx": "^4.20.4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
