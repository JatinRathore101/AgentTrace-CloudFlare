# Copy to .env and fill in. Wrangler reads CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN from the environment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_EMAIL=
CLOUDFLARE_WORKERS_SUBDOMAIN=
APP_URL=https://agenttrace.<subdomain>.workers.dev
CLOUDFLARE_API_TOKEN=
# Snapshot of `npx wrangler login` (live copy: ~/Library/Preferences/.wrangler/config/default.toml)
WRANGLER_OAUTH_TOKEN=
WRANGLER_OAUTH_TOKEN_EXPIRES=
WRANGLER_OAUTH_REFRESH_TOKEN=
